{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;DataBase=InventorySystem;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Hour",
          "fileSizeLimitBytes": "1048576",
          "roleOnFileSizeLimit": true
        }
      },
      {

        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
      
     
      
    ]
  },
  "AllowedHosts": "*"
}
